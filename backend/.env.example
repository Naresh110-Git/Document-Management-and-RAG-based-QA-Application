APP_NAME="Document Management RAG API"
APP_VERSION="0.1.0"
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@postgres:5432/rag_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

ACTIVE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_BACKEND=pgvector

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

LOG_LEVEL=INFO
LOG_DIR=logs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
